# EasyDistill 2 - Secrets template
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# The .env file is git-ignored; never commit real credentials.

# --- PAI-Token (text + VLM, OpenAI-compatible) ---
PAI_TOKEN_API_KEY=your_pai_token_key_here
PAI_TOKEN_BASE_URL=https://cn-beijing.pai-token.aliyuncs.com/v1
TEXT_MODEL=qwen3.7-max
VLM_MODEL=qwen3.6-plus

# --- DashScope (ONLY needed for wanx T2I backend via dashscope SDK) ---
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- PAI-EAS (Qwen-Image T2I) ---
EAS_ENDPOINT_URL=http://your-eas-endpoint.aliyuncs.com/v1
EAS_TOKEN=your_eas_base64_token_here
T2I_MODEL=Qwen-Image
